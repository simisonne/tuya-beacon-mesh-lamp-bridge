[Unit]
Description=Tuya Beacon-Mesh Ceiling Lamp MQTT Bridge
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
# Runs as root so btmgmt/hciconfig work without sudoers entries.
# Alternative: a non-root user with NOPASSWD sudoers for btmgmt/hciconfig.
User=root
WorkingDirectory=/opt/tuya-lamp-bridge
ExecStart=/usr/bin/python3 /opt/tuya-lamp-bridge/tuya_lamp_mqtt_bridge.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
