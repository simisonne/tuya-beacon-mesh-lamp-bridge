# Tuya Beacon-Mesh lamp bridge - configuration
# Copy this file to "config.env" in the same directory and fill in your values.
# (config.env is gitignored and never committed.)

# Sender transport:
#   "serial" (default) - commands go over USB serial to an ESP32-S3 running
#                        esp32/tuya_beacon_tx.ino (see esp32/FLASHING.md)
#   "btmgmt"           - forge + transmit on the Raspberry Pi's BCM43455
#                        (needs tuya_beacon_ctl.py + a lamp_counter.json)
SEND_MODE=serial

# Only for SEND_MODE=serial:
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD=115200

# MQTT broker (the Home Assistant Mosquitto addon works out of the box)
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=homeassistant
MQTT_PASS=your_mqtt_password

# MQTT topics
MQTT_TOPIC_PREFIX=tuya/lamp
HA_DISCOVERY_PREFIX=homeassistant

# Device naming shown in Home Assistant (entity IDs are derived from
# DEVICE_IDENTIFIER, e.g. light.tuya_beacon_lamp)
DEVICE_NAME=Tuya Ceiling Lamp
DEVICE_IDENTIFIER=tuya_beacon_lamp
